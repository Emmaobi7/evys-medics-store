# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
VITE_API_URL=http://localhost:5000/api/v1

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DB_SCHEMA=evys

# Authentication & Security
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=24h

# Development Bootstrap Admin (Development Only - Never commit production passwords)
ADMIN_EMAIL=admin@evysmedics.co.uk
ADMIN_PASSWORD=your-development-admin-password

# Commerce Defaults (Configurable, not hardcoded in logic)
SHIPPING_FREE_THRESHOLD=50.00
SHIPPING_STANDARD_RATE=4.95
DEFAULT_VAT_RATE=0.20

# Future Provider Placeholders (Do not set in production yet)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
