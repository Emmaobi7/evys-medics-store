# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
VITE_API_URL=http://localhost:5000/api/v1

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DB_SCHEMA=evys

# Authentication & Security
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=24h

# Development Bootstrap Admin (Development Only - Never commit production passwords)
ADMIN_EMAIL=admin@evysmedics.co.uk
ADMIN_PASSWORD=your-development-admin-password

# Commerce Defaults (NGN Currency & Delivery)
DEFAULT_DELIVERY_FEE=0.00
SHIPPING_FREE_THRESHOLD=0.00

# Paystack Payment Gateway (Backend Only - NEVER expose in frontend VITE_* variables)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout/callback
PAYSTACK_BASE_URL=https://api.paystack.co

# Email / Notifications (Optional Future Integration)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
